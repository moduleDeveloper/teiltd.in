# --- Build-time (SEO) ---
# Public domain of the deployed site, no trailing slash. Used for canonical / Open Graph
# URLs, robots.txt and sitemap.xml.
SITE_URL=https://your-domain.com

# --- Server-side only (NOT exposed to the browser; no VITE_ prefix) ---
# Supabase RPC that returns the catalog. Used by the Vite dev/preview proxy; in production
# configure the same on your host (see README "Catalog API (Plans section)").
CATALOG_API_URL=https://<project-ref>.supabase.co/rest/v1/rpc/get_products_by_trust_id
# Supabase ANON (public) key. Never the service_role key.
CATALOG_API_KEY=

# --- Client-side (bundled, public) ---
# Same-origin path the browser calls. Do NOT put the backend URL here.
VITE_CATALOG_ENDPOINT=/api/catalog
# Trust id sent to the RPC as `p_trust_id`.
VITE_CATALOG_TRUST_ID=
# Optional: product_code to badge as "Most chosen" (defaults to the middle plan).
VITE_FEATURED_PRODUCT_CODE=
