# Port the backend listens on (the Vite dev server proxies /api here).
PORT=5000

# Supabase RPC that returns the catalog.
CATALOG_API_URL=https://<project-ref>.supabase.co/rest/v1/rpc/get_products_by_trust_id
# Supabase ANON (public) key. Never the service_role key.
CATALOG_API_KEY=
# Trust id sent to the RPC as `p_trust_id`. Pinned here so browsers cannot change it.
CATALOG_TRUST_ID=
