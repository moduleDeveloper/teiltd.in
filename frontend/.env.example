# --- Build-time (SEO) ---
# Public domain of the deployed site, no trailing slash. Used for canonical / Open Graph
# URLs, robots.txt and sitemap.xml.
SITE_URL=https://your-domain.com

# --- Dev only ---
# Backend the Vite dev/preview server proxies /api to (see backend/.env PORT).
BACKEND_URL=http://localhost:5000

# --- Client-side (bundled, public) ---
# Same-origin path the browser calls. Do NOT put the backend URL here.
VITE_CATALOG_ENDPOINT=/api/catalog
# Optional: product_code to badge as "Most chosen" (defaults to the middle plan).
VITE_FEATURED_PRODUCT_CODE=
