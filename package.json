{
  "name": "setu-ai",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c yellow,cyan \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "lint": "npm run lint -w frontend",
    "test": "npm run test -w frontend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
